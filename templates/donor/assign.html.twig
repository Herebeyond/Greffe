{% extends 'base.html.twig' %}

{% block title %}Assigner donneur {{ donor.cristalNumber }} à une greffe{% endblock %}

{% block body %}
<div class="page-container">
    <div class="section-header">
        <h2>Assigner le donneur {{ donor.cristalNumber }} à une greffe</h2>
        <div class="page-header-actions">
            <a href="{{ path('app_donor_show', {id: donor.id}) }}" class="btn btn-secondary">Retour au donneur</a>
        </div>
    </div>

    {# ===== Donor summary ===== #}
    <section class="detail-section">
        <h2>Donneur sélectionné</h2>
        <div class="detail-grid">
            <div class="detail-item">
                <span class="detail-label">CRISTAL</span>
                <span class="detail-value"><strong>{{ donor.cristalNumber }}</strong></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Type</span>
                <span class="detail-value"><span class="badge badge-donor-{{ donor.donorType.code }}">{{ donor.donorTypeLabel }}</span></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Groupe sanguin</span>
                <span class="detail-value"><span class="blood-group blood-group-{{ donor.bloodGroup.code }}">{{ donor.fullBloodGroup }}</span></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Âge</span>
                <span class="detail-value">{{ donor.age }} ans</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Sexe</span>
                <span class="detail-value">{{ donor.sex == 'M' ? 'Masculin' : 'Féminin' }}</span>
            </div>
        </div>
    </section>

    {# ===== Filter form ===== #}
    <section class="detail-section">
        <h2>Filtrer par numéro de dossier</h2>
        <form method="post" action="{{ path('app_donor_assign', {id: donor.id}) }}" class="search-form">
            <div class="form-group">
                <label for="fileNumber">Numéro de dossier du patient</label>
                <input type="text" id="fileNumber" name="fileNumber" value="{{ fileNumber }}" placeholder="Ex: 2023-001234" class="form-control">
            </div>
            <div class="form-group form-group-actions">
                <button type="submit" class="btn btn-primary">Filtrer</button>
                {% if fileNumber %}
                <a href="{{ path('app_donor_assign', {id: donor.id}) }}" class="btn btn-secondary">Réinitialiser</a>
                {% endif %}
            </div>
        </form>
    </section>

    {# ===== Transplants without donor ===== #}
    <section class="detail-section">
        <h2>Greffes en attente de donneur ({{ transplantTotal }})</h2>
        {% if transplants is empty %}
            <p class="detail-empty">Aucune greffe sans donneur trouvée{{ fileNumber ? ' pour le dossier "' ~ fileNumber ~ '"' : '' }}.</p>
        {% else %}
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Dossier</th>
                            <th>Groupe sanguin</th>
                            <th>Âge</th>
                            <th>Sexe</th>
                            <th>Date de greffe</th>
                            <th>Rang</th>
                            <th>Type de don prévu</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for transplant in transplants %}
                        {% set patient = transplant.patient %}
                        <tr>
                            <td><strong>{{ patient.fileNumber }}</strong></td>
                            <td>
                                {% if patient.fullBloodGroup %}
                                    <span class="blood-group blood-group-{{ patient.bloodGroup.code }}">{{ patient.fullBloodGroup }}</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>{{ patient.age ? patient.age ~ ' ans' : '—' }}</td>
                            <td>{{ patient.sex == 'M' ? 'Masculin' : (patient.sex == 'F' ? 'Féminin' : '—') }}</td>
                            <td>{{ transplant.transplantDate|date('d/m/Y') }}</td>
                            <td>{{ transplant.rank }}</td>
                            <td><span class="badge badge-donor-{{ transplant.donorType.code }}">{{ transplant.donorTypeLabel }}</span></td>
                            <td class="actions-cell">
                                <a href="{{ path('app_patient_show', {id: patient.id}) }}" class="btn-small">Voir patient</a>
                                <form method="post" action="{{ path('app_donor_assign', {id: donor.id}) }}" class="inline-form"
                                      onsubmit="return confirm('Confirmer l\'assignation du donneur {{ donor.cristalNumber }} à cette greffe (dossier {{ patient.fileNumber }}) ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('assign' ~ donor.id) }}">
                                    <input type="hidden" name="transplantId" value="{{ transplant.id }}">
                                    <button type="submit" class="btn-small btn-small-success">Assigner</button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if transplantTotalPages > 1 %}
            <nav class="pagination">
                {% set startPage = max(1, transplantPage - 2) %}
                {% set endPage = min(transplantTotalPages, transplantPage + 2) %}
                <form method="post" action="{{ path('app_donor_assign', {id: donor.id}) }}" class="inline-form">
                    <input type="hidden" name="fileNumber" value="{{ fileNumber }}">
                    <input type="hidden" name="patientPage" value="{{ patientPage }}">

                    <button type="submit" name="transplantPage" value="{{ transplantPage - 1 }}" class="pagination-link" {{ transplantPage <= 1 ? 'disabled' : '' }}>&laquo; Précédent</button>

                    {% if startPage > 1 %}
                        <button type="submit" name="transplantPage" value="1" class="pagination-link">1</button>
                        {% if startPage > 2 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                    {% endif %}

                    {% for p in startPage..endPage %}
                        <button type="submit" name="transplantPage" value="{{ p }}" class="pagination-link{{ p == transplantPage ? ' active' : '' }}">{{ p }}</button>
                    {% endfor %}

                    {% if endPage < transplantTotalPages %}
                        {% if endPage < transplantTotalPages - 1 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                        <button type="submit" name="transplantPage" value="{{ transplantTotalPages }}" class="pagination-link">{{ transplantTotalPages }}</button>
                    {% endif %}

                    <label for="transplant-page-select" class="pagination-info">Aller à</label>
                    <select id="transplant-page-select" name="transplantPage" class="form-control pagination-select">
                        {% for p in 1..transplantTotalPages %}
                            <option value="{{ p }}"{{ p == transplantPage ? ' selected' : '' }}>{{ p }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="pagination-link">OK</button>

                    <button type="submit" name="transplantPage" value="{{ transplantPage + 1 }}" class="pagination-link" {{ transplantPage >= transplantTotalPages ? 'disabled' : '' }}>Suivant &raquo;</button>
                </form>
            </nav>
            {% endif %}
        {% endif %}
    </section>

    {# ===== Patients with no transplant record ===== #}
    <section class="detail-section">
        <h2>Patients sans greffe enregistrée ({{ patientTotal }})</h2>
        {% if patientsWithoutTransplant is empty %}
            <p class="detail-empty">Aucun patient sans greffe trouvée{{ fileNumber ? ' pour le dossier "' ~ fileNumber ~ '"' : '' }}.</p>
        {% else %}
            <p class="detail-empty">Utilisez « Assigner » pour créer immédiatement la pré-affectation de greffe depuis cette page. Le médecin complétera ensuite les données médicales.</p>
            <div class="data-table-container">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Dossier</th>
                            <th>Groupe sanguin</th>
                            <th>Âge</th>
                            <th>Sexe</th>
                            <th>Statut</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for patient in patientsWithoutTransplant %}
                        <tr>
                            <td><strong>{{ patient.fileNumber }}</strong></td>
                            <td>
                                {% if patient.fullBloodGroup %}
                                    <span class="blood-group blood-group-{{ patient.bloodGroup.code }}">{{ patient.fullBloodGroup }}</span>
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>{{ patient.age ? patient.age ~ ' ans' : '—' }}</td>
                            <td>{{ patient.sex == 'M' ? 'Masculin' : (patient.sex == 'F' ? 'Féminin' : '—') }}</td>
                            <td><span class="badge">Aucune greffe enregistrée</span></td>
                            <td class="actions-cell">
                                <a href="{{ path('app_patient_show', {id: patient.id}) }}" class="btn-small">Voir patient</a>
                                <form method="post" action="{{ path('app_donor_assign', {id: donor.id}) }}" class="inline-form"
                                      onsubmit="return confirm('Confirmer l\'assignation du donneur {{ donor.cristalNumber }} au patient {{ patient.fileNumber }} et créer la pré-affectation de greffe ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('assign' ~ donor.id) }}">
                                    <input type="hidden" name="patientId" value="{{ patient.id }}">
                                    <button type="submit" class="btn-small btn-small-success">Assigner</button>
                                </form>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if patientTotalPages > 1 %}
            <nav class="pagination">
                {% set startPage = max(1, patientPage - 2) %}
                {% set endPage = min(patientTotalPages, patientPage + 2) %}
                <form method="post" action="{{ path('app_donor_assign', {id: donor.id}) }}" class="inline-form">
                    <input type="hidden" name="fileNumber" value="{{ fileNumber }}">
                    <input type="hidden" name="transplantPage" value="{{ transplantPage }}">

                    <button type="submit" name="patientPage" value="{{ patientPage - 1 }}" class="pagination-link" {{ patientPage <= 1 ? 'disabled' : '' }}>&laquo; Précédent</button>

                    {% if startPage > 1 %}
                        <button type="submit" name="patientPage" value="1" class="pagination-link">1</button>
                        {% if startPage > 2 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                    {% endif %}

                    {% for p in startPage..endPage %}
                        <button type="submit" name="patientPage" value="{{ p }}" class="pagination-link{{ p == patientPage ? ' active' : '' }}">{{ p }}</button>
                    {% endfor %}

                    {% if endPage < patientTotalPages %}
                        {% if endPage < patientTotalPages - 1 %}
                            <span class="pagination-ellipsis">...</span>
                        {% endif %}
                        <button type="submit" name="patientPage" value="{{ patientTotalPages }}" class="pagination-link">{{ patientTotalPages }}</button>
                    {% endif %}

                    <label for="patient-page-select" class="pagination-info">Aller à</label>
                    <select id="patient-page-select" name="patientPage" class="form-control pagination-select">
                        {% for p in 1..patientTotalPages %}
                            <option value="{{ p }}"{{ p == patientPage ? ' selected' : '' }}>{{ p }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="pagination-link">OK</button>

                    <button type="submit" name="patientPage" value="{{ patientPage + 1 }}" class="pagination-link" {{ patientPage >= patientTotalPages ? 'disabled' : '' }}>Suivant &raquo;</button>
                </form>
            </nav>
            {% endif %}
        {% endif %}
    </section>
</div>
{% endblock %}
