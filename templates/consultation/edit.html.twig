{% extends 'base.html.twig' %}

{% block title %}Modifier consultation - {{ patient.fullName }}{% endblock %}

{% block body %}
<div class="patient-page">
    {% include 'patient/_medical_nav.html.twig' %}

    <div class="section-header">
        <h2>Modifier la consultation</h2>
    </div>

    <div class="form-container">
        {% if consultation.attachmentFilenames is not empty %}
        <div class="existing-files-list">
            <span class="existing-files-title">Fichiers joints :</span>
            {% for filename in consultation.attachmentFilenames %}
            <div class="existing-file">
                <a href="{{ path('app_consultation_download', {patientId: patient.id, id: consultation.id, filename: filename}) }}" class="file-link" target="_blank">{{ filename }}</a>
                {% if is_granted('CAN_WRITE') %}
                <form action="{{ path('app_consultation_delete_file', {patientId: patient.id, id: consultation.id, filename: filename}) }}" method="post" class="inline-form"
                      onsubmit="return confirm('Supprimer ce fichier ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-file' ~ consultation.id) }}">
                    <button type="submit" class="btn-small btn-small-danger">Supprimer</button>
                </form>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        {% endif %}

        {{ form_start(form) }}
            <div class="form-grid">
                <div class="form-group">
                    {{ form_row(form.date) }}
                </div>
                <div class="form-group">
                    {{ form_row(form.type) }}
                </div>
            </div>
            <div class="form-group">
                {{ form_row(form.observations) }}
            </div>
            <div class="form-group">
                {{ form_row(form.treatmentNotes) }}
            </div>
            <div class="form-group">
                {{ form_row(form.nextAppointmentDate) }}
            </div>
            <div class="form-group">
                {{ form_row(form.attachmentFiles) }}
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                <a href="{{ path('app_consultation_index', {patientId: patient.id}) }}" class="btn btn-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
