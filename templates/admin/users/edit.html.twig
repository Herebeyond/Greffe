{% extends 'base.html.twig' %}

{% block title %}Modifier {{ user.fullName }}{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1>Modifier l'utilisateur</h1>
        <a href="{{ path('app_admin_users') }}" class="btn btn-secondary">Retour à la liste</a>
    </div>

    {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
        <div class="form-section">
            <h3 class="form-section-title">Informations personnelles</h3>
            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.name) }}
                    {{ form_widget(form.name) }}
                    {{ form_errors(form.name) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.surname) }}
                    {{ form_widget(form.surname) }}
                    {{ form_errors(form.surname) }}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.cristalId) }}
                    {{ form_widget(form.cristalId) }}
                    {{ form_errors(form.cristalId) }}
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Mot de passe</h3>
            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.plainPassword.first) }}
                    {{ form_widget(form.plainPassword.first) }}
                    {{ form_errors(form.plainPassword.first) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.plainPassword.second) }}
                    {{ form_widget(form.plainPassword.second) }}
                    {{ form_errors(form.plainPassword.second) }}
                </div>
            </div>
        </div>

        {% if form.roles is defined %}
        <div class="form-section">
            <h3 class="form-section-title">Rôles et permissions</h3>
            <div class="form-group">
                <div class="checkbox-group">
                    {{ form_widget(form.roles) }}
                </div>
                {{ form_errors(form.roles) }}
            </div>
            {% if not is_granted('ROLE_SUPER_ADMIN') %}
            <div class="alert alert-info">
                Les rôles Admin technique et Super Admin sont réservés au Super Admin.
            </div>
            {% endif %}
        </div>
        {% endif %}

        <div class="form-section">
            <h3 class="form-section-title">État du compte</h3>
            <div class="form-group">
                {{ form_row(form.isActive) }}
            </div>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
