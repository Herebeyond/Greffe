{% extends 'base.html.twig' %}

{% block title %}Administration - Utilisateurs{% endblock %}

{% block body %}
<div class="admin-container">
    <div class="admin-header">
        <h1>Gestion des Utilisateurs</h1>
        <a href="{{ path('app_admin_users_new') }}" class="btn btn-primary">Ajouter un utilisateur</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    <table class="admin-table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Prénom</th>
                <th>Email</th>
                <th>ID CRISTAL</th>
                <th>Rôles</th>
                <th>Statut</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.surname }}</td>
                <td>{{ user.name }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.cristalId ?? '-' }}</td>
                <td>
                    {% for role in user.roles %}
                        {% set role_key = role|lower|replace({'role_': ''}) %}
                        {% set role_labels = {
                            'ROLE_SUPER_ADMIN': 'Super Admin',
                            'ROLE_TECH_ADMIN': 'Admin',
                            'ROLE_DOCTOR': 'Docteur',
                            'ROLE_NURSE': 'Infirmier(e)',
                            'ROLE_TRANSPLANT_COORDINATOR': 'Coordinateur',
                            'ROLE_USER': 'Utilisateur'
                        } %}
                        <span class="badge badge-{{ role_key }}">
                            {{ role_labels[role] ?? role|replace({'ROLE_': ''}) }}
                        </span>
                    {% endfor %}
                </td>
                <td>
                    {% if user.isActive %}
                        <span class="badge badge-success">Actif</span>
                    {% else %}
                        <span class="badge badge-danger">Désactivé</span>
                    {% endif %}
                </td>
                <td class="actions">
                    {% set has_admin_role = false %}
                    {% for role in user.roles %}
                        {% if role in ['ROLE_SUPER_ADMIN', 'ROLE_TECH_ADMIN'] %}
                            {% set has_admin_role = true %}
                        {% endif %}
                    {% endfor %}
                    {% if is_granted('ROLE_SUPER_ADMIN') or not has_admin_role %}
                    <a href="{{ path('app_admin_users_edit', {id: user.id}) }}" class="btn btn-small btn-secondary">Modifier</a>
                    {% if app.user and app.user.id != user.id %}
                    <form action="{{ path('app_admin_users_toggle_active', {id: user.id}) }}" method="post" class="delete-form" onsubmit="return confirm('{{ user.isActive ? 'Désactiver' : 'Réactiver' }} cet utilisateur ?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_active' ~ user.id) }}">
                        <button type="submit" class="btn btn-small {{ user.isActive ? 'btn-warning' : 'btn-success' }}">{{ user.isActive ? 'Désactiver' : 'Réactiver' }}</button>
                    </form>
                    {% endif %}
                    {% if app.user and app.user.id != user.id %}
                    <form action="{{ path('app_admin_users_delete', {id: user.id}) }}" method="post" class="delete-form account-delete-form" data-user-name="{{ user.fullName }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button type="submit" class="btn btn-small btn-danger">Supprimer</button>
                    </form>
                    {% endif %}
                    {% endif %}
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="9" class="empty-table">Aucun utilisateur trouvé</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.account-delete-form').forEach(function (form) {
        var button = form.querySelector('button[type="submit"]');
        if (!button) {
            return;
        }

        var armed = false;
        var countdown = 0;
        var timerId = null;
        var baseText = button.textContent;
        var targetName = form.dataset.userName || 'cet utilisateur';

        form.addEventListener('submit', function (event) {
            if (!armed) {
                event.preventDefault();

                if (timerId) {
                    clearInterval(timerId);
                }

                countdown = 5;
                button.disabled = true;
                button.textContent = 'Confirmer (' + countdown + 's)';

                timerId = setInterval(function () {
                    countdown -= 1;
                    if (countdown <= 0) {
                        clearInterval(timerId);
                        armed = true;
                        button.disabled = false;
                        button.textContent = 'Confirmer suppression';
                        return;
                    }

                    button.textContent = 'Confirmer (' + countdown + 's)';
                }, 1000);

                return;
            }

            if (!confirm('Êtes-vous absolument sûr de vouloir supprimer ' + targetName + ' ? Cette action est irréversible.')) {
                event.preventDefault();
                armed = false;
                button.disabled = false;
                button.textContent = baseText;
            }
        });
    });
});
</script>
{% endblock %}
