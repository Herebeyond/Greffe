{% extends 'base.html.twig' %}

{% block title %}{{ is_granted('ROLE_TRANSPLANT_COORDINATOR') ? 'Patient anonyme' : patient.fullName }} - Gestion des Greffes Rénales{% endblock %}

{% block body %}
<div class="patient-page">
    {% set isCoordinator = is_granted('ROLE_TRANSPLANT_COORDINATOR') %}
    <div class="page-header">
        <div class="page-header-content">
            <h1>{{ isCoordinator ? 'Patient anonyme' : patient.fullName }}</h1>
            <span class="patient-identifier">Dossier n° {{ patient.fileNumber }}</span>
        </div>
        <div class="page-header-actions">
            {% if is_granted('CAN_WRITE') %}
            <a href="{{ path('app_patient_edit', {id: patient.id}) }}" class="btn btn-primary">Modifier</a>
            {% endif %}
            <a href="{{ path('app_patient_index') }}" class="btn btn-secondary">Retour à la liste</a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {% if btgAccess %}
    <div class="btg-banner" data-expires="{{ btgAccess.expiresAt|date('c') }}">
        <div class="btg-banner-icon">⚠️</div>
        <div class="btg-banner-text">
            <strong>Accès d'urgence (Bris de glace)</strong> — Cet accès est temporaire et sera audité.
            <br>Temps restant : <span class="btg-countdown"></span>
        </div>
    </div>
    {% endif %}

        {# Medical section navigation tabs #}
    <div class="patient-medical-sections">
        <nav class="medical-nav">
            <a href="{{ path('app_medical_history_index', {patientId: patient.id}) }}" class="medical-nav-item">Antécédents</a>
            <a href="{{ path('app_consultation_index', {patientId: patient.id}) }}" class="medical-nav-item">Consultations</a>
            <a href="{{ path('app_transplant_index', {patientId: patient.id}) }}" class="medical-nav-item">Greffes</a>
            <a href="{{ path('app_therapeutic_education_index', {patientId: patient.id}) }}" class="medical-nav-item">ETP</a>
            <a href="{{ path('app_biological_result_index', {patientId: patient.id}) }}" class="medical-nav-item">Résultats biologiques</a>
        </nav>
    </div>

    <div class="patient-details">
        <section class="detail-section">
            <h2>Identification</h2>
            <div class="detail-grid">
                {% if not isCoordinator %}
                <div class="detail-item">
                    <span class="detail-label">ID</span>
                    <span class="detail-value"><strong>{{ patient.id }}</strong></span>
                </div>
                {% endif %}
                <div class="detail-item">
                    <span class="detail-label">Nom</span>
                    <span class="detail-value">{{ isCoordinator ? 'Anonyme' : patient.lastName }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Prénom</span>
                    <span class="detail-value">{{ isCoordinator ? 'Anonyme' : patient.firstName }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Numéro de dossier</span>
                    <span class="detail-value">{{ patient.fileNumber }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Ville de résidence</span>
                    <span class="detail-value">{{ patient.city }}</span>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <h2>Informations médicales</h2>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Date de naissance</span>
                    <span class="detail-value">
                        {% if patient.birthDate %}
                            {{ patient.birthDate|date('d/m/Y') }}
                            <span class="detail-secondary">({{ patient.age }} ans)</span>
                        {% else %}
                            <span class="detail-empty">Non renseigné</span>
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Sexe</span>
                    <span class="detail-value">
                        {% if patient.sexLabel %}
                            {{ patient.sexLabel }}
                        {% else %}
                            <span class="detail-empty">Non renseigné</span>
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Groupe sanguin</span>
                    <span class="detail-value">
                        {% if patient.bloodGroup %}
                            <span class="blood-group blood-group-{{ patient.bloodGroup.code }}">{{ patient.fullBloodGroup }}</span>
                        {% else %}
                            <span class="detail-empty">Non renseigné</span>
                        {% endif %}
                    </span>
                </div>
            </div>
        </section>

        <section class="detail-section">
            <h2>Statut greffe</h2>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Statut</span>
                    <span class="detail-value">
                        <span class="transplant-status {{ patient.transplantStatusClass }}">{{ patient.transplantStatusLabel }}</span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Nombre de greffes</span>
                    <span class="detail-value">{{ patient.transplantCount }}</span>
                </div>
                {% if patient.failedTransplantCount > 0 %}
                <div class="detail-item">
                    <span class="detail-label">Greffes échouées</span>
                    <span class="detail-value">
                        <span class="transplant-status status-failed">{{ patient.failedTransplantCount }}</span>
                    </span>
                </div>
                {% endif %}
                {% for transplant in patient.transplants %}
                <div class="detail-item" style="grid-column: 1 / -1;">
                    <span class="detail-label">Greffe n°{{ transplant.rank }} — {{ transplant.transplantDate ? transplant.transplantDate|date('d/m/Y') : 'En attente de réalisation' }}</span>
                    <span class="detail-value">
                        {% if transplant.isGraftFunctional %}
                            <span class="transplant-status status-active">Greffon fonctionnel</span>
                        {% elseif transplant.assignedDraft %}
                            <span class="transplant-status status-waiting">Greffe assignée - en attente de réalisation</span>
                        {% else %}
                            <span class="transplant-status status-failed">Greffon non fonctionnel</span>
                            {% if transplant.graftEndCause %}
                                — {{ transplant.graftEndCause }}
                            {% endif %}
                            {% if transplant.graftEndDate %}
                                ({{ transplant.graftEndDate|date('d/m/Y') }})
                            {% endif %}
                        {% endif %}
                    </span>
                </div>
                {% endfor %}
            </div>
        </section>

        <section class="detail-section">
            <h2>Contact</h2>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Téléphone</span>
                    <span class="detail-value">
                        {% if isCoordinator %}
                            <span class="detail-empty">Masqué pour anonymisation</span>
                        {% else %}
                        {% if patient.phone %}
                            <a href="tel:{{ patient.phone }}">{{ patient.phone }}</a>
                        {% else %}
                            <span class="detail-empty">Non renseigné</span>
                        {% endif %}
                        {% endif %}
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Email</span>
                    <span class="detail-value">
                        {% if isCoordinator %}
                            <span class="detail-empty">Masqué pour anonymisation</span>
                        {% else %}
                        {% if patient.email %}
                            <a href="mailto:{{ patient.email }}">{{ patient.email }}</a>
                        {% else %}
                            <span class="detail-empty">Non renseigné</span>
                        {% endif %}
                        {% endif %}
                    </span>
                </div>
            </div>
        </section>

        {% if patient.comment %}
        <section class="detail-section">
            <h2>Commentaires</h2>
            <div class="detail-comment">
                {{ patient.comment|nl2br }}
            </div>
        </section>
        {% endif %}

        <section class="detail-section">
            <h2>Informations système</h2>
            <div class="detail-grid">
                <div class="detail-item">
                    <span class="detail-label">Créé le</span>
                    <span class="detail-value">{{ patient.createdAt|date('d/m/Y à H:i') }}</span>
                </div>
                {% if patient.updatedAt %}
                <div class="detail-item">
                    <span class="detail-label">Dernière modification</span>
                    <span class="detail-value">{{ patient.updatedAt|date('d/m/Y à H:i') }}</span>
                </div>
                {% endif %}
            </div>
        </section>
    </div>

    {# Access management section #}
    {% if accessRecords is defined %}
    <div class="patient-details">
        <section class="detail-section">
            <h2>Équipe de soins</h2>
            <div class="access-list">
                {% for access in accessRecords %}
                <div class="access-item">
                    <span class="access-user">{{ access.user.fullName }}</span>
                    {% for role in access.user.roles %}
                        {% set role_labels = {'ROLE_DOCTOR': 'Médecin', 'ROLE_NURSE': 'Infirmier(e)'} %}
                        {% if role_labels[role] is defined %}
                            <span class="badge badge-{{ role|lower|replace({'role_': ''}) }}">{{ role_labels[role] }}</span>
                        {% endif %}
                    {% endfor %}
                    {% if access.isPrimary %}
                        <span class="badge badge-access-primary">Principal</span>
                    {% endif %}
                </div>
                {% else %}
                <p class="empty-message">Aucun praticien assigné.</p>
                {% endfor %}
            </div>
            {% if canManageAccess is defined and canManageAccess %}
            <div class="section-actions">
                <a href="{{ path('app_patient_access', {patientId: patient.id}) }}" class="btn btn-secondary">Gérer les accès</a>
            </div>
            {% endif %}
        </section>
    </div>
    {% endif %}

    {% if is_granted('CAN_DELETE') %}
    <div class="danger-zone">
        <h2>Zone de danger</h2>
        <form action="{{ path('app_patient_delete', {id: patient.id}) }}" method="post" 
              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce patient ? Cette action est irréversible.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ patient.id) }}">
            <button type="submit" class="btn btn-danger">Supprimer ce patient</button>
        </form>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
{% if btgAccess %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    function updateCountdowns() {
        document.querySelectorAll('.btg-banner').forEach(function(banner) {
            var expiresAt = new Date(banner.dataset.expires);
            var now = new Date();
            var diff = expiresAt - now;
            var countdown = banner.querySelector('.btg-countdown');

            if (diff <= 0) {
                countdown.textContent = 'expiré';
                return;
            }

            var hours = Math.floor(diff / 3600000);
            var minutes = Math.floor((diff % 3600000) / 60000);
            var seconds = Math.floor((diff % 60000) / 1000);

            var parts = [];
            if (hours > 0) parts.push(hours + 'h');
            parts.push(minutes + 'min');
            parts.push(seconds + 's');
            countdown.textContent = parts.join(' ');
        });
    }

    updateCountdowns();
    setInterval(updateCountdowns, 1000);
});
</script>
{% endif %}
{% endblock %}
