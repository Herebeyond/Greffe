{% extends 'base.html.twig' %}

{% block title %}Notifications - Gestion des Greffes Rénales{% endblock %}

{% block body %}
<div class="notification-page">
    <div class="page-header">
        <h1>Notifications{% if unreadCount > 0 %} <span class="notification-badge-large">{{ unreadCount }} non lue{{ unreadCount > 1 ? 's' : '' }}</span>{% endif %}</h1>
        {% if unreadCount > 0 %}
        <form method="post" action="{{ path('app_notification_read_all') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('notification_read_all') }}">
            <button type="submit" class="btn btn-secondary">Tout marquer comme lu</button>
        </form>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
    {% endfor %}

    {% if notifications is empty %}
        <div class="empty-state">
            <p>Aucune notification.</p>
        </div>
    {% else %}
        <div class="notification-list">
            {% for notification in notifications %}
                <div class="notification-item {{ not notification.read ? 'notification-unread' : 'notification-read' }}">
                    <div class="notification-content">
                        <div class="notification-header">
                            <span class="notification-type notification-type-{{ notification.type }}">{{ notification.typeLabel }}</span>
                            <span class="notification-date">{{ notification.createdAt|date('d/m/Y H:i') }}</span>
                        </div>
                        <p class="notification-message">{{ notification.message }}</p>
                        {% if notification.relatedPatient %}
                            <span class="notification-meta">Patient : {{ notification.relatedPatient.fullName }}</span>
                        {% endif %}
                        {% if notification.triggeredBy %}
                            <span class="notification-meta">Par : {{ notification.triggeredBy.fullName }}</span>
                        {% endif %}
                    </div>
                    {% if not notification.read %}
                        <form method="post" action="{{ path('app_notification_read', {id: notification.id}) }}" class="notification-action">
                            <input type="hidden" name="_token" value="{{ csrf_token('notification_read' ~ notification.id) }}">
                            <button type="submit" class="btn btn-small" title="Marquer comme lu">✓</button>
                        </form>
                    {% else %}
                        <span class="notification-read-indicator" title="Lu le {{ notification.readAt|date('d/m/Y H:i') }}">✓</span>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
